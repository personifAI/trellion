# Copy to `.env` (same directory) and edit.
#
# Any HF model ID that vLLM supports will work. Pick something that fits your
# VRAM; 8B is a reasonable default for extraction-style prompts.
VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# TEI supports BGE, E5, GTE families out of the box. BGE-large-en-v1.5 is a
# solid default for entity description embeddings.
TEI_MODEL=BAAI/bge-large-en-v1.5

# Only needed if you pull gated models.
HUGGING_FACE_HUB_TOKEN=
